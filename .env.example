# Canonical public origin, no trailing slash. Set on the Vercel Production environment.
SITE_URL=

# Email delivery. Never prefix these secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
# Bare email address on your Resend-verified sending domain (not a Gmail sender).
FORM_FROM_EMAIL=
# Fixed server-side destination. Omit to use the SportAbility inbox below.
FORM_TO_EMAIL=sportabilityathletics@gmail.com

# Cloudflare Turnstile widget. Only the site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact hostnames without https://, paths, or ports, separated by commas.
# Use the production domain in Production and specific preview hosts in Preview.
TURNSTILE_ALLOWED_HOSTNAMES=
